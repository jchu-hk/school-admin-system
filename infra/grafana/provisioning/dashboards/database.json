{
  "dashboard": {
    "title": "Database Monitoring - F-OPS-001",
    "uid": "database-monitoring",
    "tags": ["database", "postgresql", "monitoring"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "PostgreSQL Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_up",
            "legendFormat": "Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "1": {"text": "UP", "color": "green"},
                  "0": {"text": "DOWN", "color": "red"}
                }
              }
            ]
          }
        },
        "description": "PostgreSQL服务状态"
      },
      {
        "title": "Connection Pool Usage",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "postgres_connection_usage * 100",
            "legendFormat": "Usage %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 60},
                {"color": "orange", "value": 80},
                {"color": "red", "value": 95}
              ]
            }
          }
        },
        "description": "连接池使用率 (< 80% 安全)"
      },
      {
        "title": "Active Connections",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "legendFormat": "{{state}}"
          },
          {
            "expr": "pg_settings_max_connections",
            "legendFormat": "Max Connections"
          }
        ],
        "description": "活跃连接数统计"
      },
      {
        "title": "WAL Backlog Size",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "postgres_wal_archive_backlog",
            "legendFormat": "WAL Backlog (MB)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MB",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 200},
                {"color": "red", "value": 500}
              ]
            }
          }
        },
        "description": "WAL积压大小监控 (< 500MB 警告)"
      },
      {
        "title": "WAL Backlog Alert",
        "type": "stat",
        "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "postgres_wal_archive_backlog > 500",
            "legendFormat": "Critical"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "OK", "color": "green"},
                  "1": {"text": "HIGH", "color": "red"}
                }
              }
            ]
          }
        }
      },
      {
        "title": "Query Response Time (P95)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(pg_query_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(pg_query_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          },
          {
            "expr": "histogram_quantile(0.50, rate(pg_query_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "description": "查询响应时间百分位"
      },
      {
        "title": "Slow Queries",
        "type": "stat",
        "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "increase(pg_slow_queries_total[5m])",
            "legendFormat": "Slow Queries/5min"
          }
        ],
        "description": "慢查询数量 (> 1s)"
      },
      {
        "title": "Replication Lag",
        "type": "graph",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "pg_replication_lag_seconds",
            "legendFormat": "{{replica}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 30}
              ]
            }
          }
        },
        "description": "主从复制延迟"
      },
      {
        "title": "Replication Status",
        "type": "stat",
        "gridPos": {"x": 12, "y": 12, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_replication_status",
            "legendFormat": "{{replica}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "1": {"text": "SYNC", "color": "green"},
                  "0": {"text": "ASYNC", "color": "yellow"},
                  "-1": {"text": "DOWN", "color": "red"}
                }
              }
            ]
          }
        }
      },
      {
        "title": "Transaction Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit[5m])",
            "legendFormat": "Commits/s"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback[5m])",
            "legendFormat": "Rollbacks/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "description": "事务提交/回滚率"
      },
      {
        "title": "Rollback Rate",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_rollback[5m]) / (rate(pg_stat_database_xact_commit[5m]) + rate(pg_stat_database_xact_rollback[5m])) * 100",
            "legendFormat": "Rollback %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "title": "Deadlocks",
        "type": "graph",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "rate(pg_stat_database_deadlocks[5m])",
            "legendFormat": "Deadlocks/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "description": "死锁发生率"
      },
      {
        "title": "Lock Wait Count",
        "type": "stat",
        "gridPos": {"x": 12, "y": 20, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_locks_waiting_count",
            "legendFormat": "Waiting"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 20}
              ]
            }
          }
        }
      },
      {
        "title": "Database Size",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "pg_database_size_bytes / 1024 / 1024 / 1024",
            "legendFormat": "{{database}} (GB)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "GB"
          }
        }
      },
      {
        "title": "Table Bloat",
        "type": "stat",
        "gridPos": {"x": 12, "y": 24, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_table_bloat_ratio * 100",
            "legendFormat": "{{table}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 40}
              ]
            }
          }
        },
        "description": "表膨胀率 (> 20% 需要VACUUM)"
      },
      {
        "title": "Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read) * 100",
            "legendFormat": "Hit Ratio %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 95}
              ]
            }
          }
        },
        "description": "缓存命中率 (> 95% 为佳)"
      },
      {
        "title": "Temp Files",
        "type": "graph",
        "gridPos": {"x": 6, "y": 28, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "rate(pg_stat_database_temp_files[5m])",
            "legendFormat": "Temp Files/s"
          },
          {
            "expr": "rate(pg_stat_database_temp_bytes[5m]) / 1024 / 1024",
            "legendFormat": "Temp MB/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "description": "临时文件使用 (可能需要调整work_mem)"
      }
    ]
  }
}