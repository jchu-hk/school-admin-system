{
  "title": "OPS Health Overview - F-OPS-009",
  "uid": "ops-health-overview",
  "tags": [
    "ops",
    "health",
    "monitoring"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "System Health Score",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(\n  (up{job=~\"school-backend|node_exporter|cadvisor|prometheus\"} == 1) * 100\n) * 100\n",
          "legendFormat": "Health Score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "title": "Services Status",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(up == 1)",
          "legendFormat": "Healthy"
        },
        {
          "expr": "count(up == 0)",
          "legendFormat": "Down"
        }
      ],
      "options": {
        "colorMode": "background"
      }
    },
    {
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"})",
          "legendFormat": "Critical"
        },
        {
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"warning\"})",
          "legendFormat": "Warning"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "title": "Container CPU Usage",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "docker_container_cpu_percent{job=\"cadvisor\"}",
          "legendFormat": "{{docker_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "description": "各容器CPU使用率 (docker cadvisor)"
    },
    {
      "title": "Container Memory Usage",
      "type": "graph",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "docker_container_mem_percent{job=\"cadvisor\"}",
          "legendFormat": "{{docker_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "description": "各容器内存使用率 (docker cadvisor)"
    },
    {
      "title": "Container Memory (MB)",
      "type": "graph",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "docker_container_mem_usage_bytes{job=\"cadvisor\"} / 1024 / 1024",
          "legendFormat": "{{docker_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB"
        }
      },
      "description": "各容器内存实际使用量"
    },
    {
      "title": "Container Network RX",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(docker_container_net_rx_bytes{job=\"cadvisor\"}[1m])",
          "legendFormat": "{{docker_service}} RX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "description": "容器网络接收速率"
    },
    {
      "title": "Container Network TX",
      "type": "graph",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(docker_container_net_tx_bytes{job=\"cadvisor\"}[1m])",
          "legendFormat": "{{docker_service}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "description": "容器网络发送速率"
    },
    {
      "title": "Node CPU & Memory Usage",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}} - CPU"
        },
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "legendFormat": "{{instance}} - Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "title": "Disk Space Usage",
      "type": "graph",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) * 100",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        }
      }
    },
    {
      "title": "System Load",
      "type": "graph",
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "node_load1",
          "legendFormat": "Load 1m"
        },
        {
          "expr": "node_load5",
          "legendFormat": "Load 5m"
        },
        {
          "expr": "node_load15",
          "legendFormat": "Load 15m"
        }
      ],
      "description": "系统负载 (node_exporter)"
    },
    {
      "title": "PostgreSQL — 需部署导出器",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "absent(postgres_connection_usage)",
          "legendFormat": "No data — postgres_exporter未部署"
        }
      ],
      "description": "待 postgres_exporter 部署后启用：连接池、WAL积压、查询性能",
      "transparent": true
    },
    {
      "title": "Redis — 需部署导出器",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 19,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "absent(redis_cache_hit_rate)",
          "legendFormat": "No data — redis_exporter未部署"
        }
      ],
      "description": "待 redis_exporter 部署后启用：缓存命中率、键统计",
      "transparent": true
    },
    {
      "title": "HTTP Metrics — 需后端instrumentation",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "absent(http_requests_total)",
          "legendFormat": "No data — 需添加HTTP Metrics中间件"
        }
      ],
      "description": "待后端添加 prom-client HTTP 中间件后启用：请求量、响应时间、错误率",
      "transparent": true
    },
    {
      "title": "Application Metrics — 需代码埋点",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "absent(audit_log_sequence_gap_size)",
          "legendFormat": "No data — 需应用代码埋点"
        }
      ],
      "description": "待埋点后启用：审计日志、Coze配额、敏感字段访问、DDL、备份、SSL",
      "transparent": true
    }
  ],
  "folderUid": "ops-monitoring"
}
