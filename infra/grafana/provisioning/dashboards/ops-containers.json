{
  "title": "容器监控 - OPS Container Monitor",
  "uid": "ops-containers",
  "tags": [
    "ops",
    "containers",
    "docker"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Container Count",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(docker_container_up == 1)",
          "legendFormat": "Running"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "title": "Container CPU Usage (Top 5)",
      "type": "barchart",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "targets": [
        {
          "expr": "topk(5, docker_container_cpu_percent)",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "title": "Container Memory Usage (Top 5)",
      "type": "barchart",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "targets": [
        {
          "expr": "topk(5, docker_container_mem_usage_bytes)",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Container CPU by Name",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "docker_container_cpu_percent",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "title": "Container Memory by Name",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "docker_container_mem_usage_bytes",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Container Network I/O",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "docker_container_net_rx_bytes",
          "legendFormat": "RX {{ name }}"
        },
        {
          "expr": "docker_container_net_tx_bytes",
          "legendFormat": "TX {{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Container Memory % of Limit",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "docker_container_mem_percent",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "title": "Container Status",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "docker_container_up",
          "legendFormat": "{{ name }}"
        },
        {
          "expr": "docker_container_cpu_percent",
          "legendFormat": "{{ name }} CPU"
        },
        {
          "expr": "docker_container_mem_percent",
          "legendFormat": "{{ name }} Mem%"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "name": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": []
              }
            }
          }
        }
      ]
    }
  ],
  "folderUid": "ops-monitoring"
}