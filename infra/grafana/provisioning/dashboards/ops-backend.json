{
  "title": "后端API监控 - OPS Backend",
  "uid": "ops-backend",
  "tags": [
    "ops",
    "backend",
    "api"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "API Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "up{job=\"school-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "title": "Container CPU",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "docker_container_cpu_percent{name=\"school-admin-backend\"}",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "title": "Container Memory",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "docker_container_mem_percent{name=\"school-admin-backend\"}",
          "legendFormat": "Mem %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "title": "Memory Usage",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "docker_container_mem_usage_bytes{name=\"school-admin-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        }
      }
    },
    {
      "title": "PIDs",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "docker_container_pids{name=\"school-admin-backend\"}",
          "legendFormat": "PIDs"
        }
      ]
    },
    {
      "title": "Network I/O",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "docker_container_net_rx_bytes{name=\"school-admin-backend\"}",
          "legendFormat": "RX"
        },
        {
          "expr": "docker_container_net_tx_bytes{name=\"school-admin-backend\"}",
          "legendFormat": "TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        }
      }
    },
    {
      "title": "Backend CPU Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "docker_container_cpu_percent{name=\"school-admin-backend\"}",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "title": "Backend Memory Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "docker_container_mem_usage_bytes{name=\"school-admin-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Backend Network I/O",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(docker_container_net_rx_bytes{name=\"school-admin-backend\"}[5m])",
          "legendFormat": "RX"
        },
        {
          "expr": "rate(docker_container_net_tx_bytes{name=\"school-admin-backend\"}[5m])",
          "legendFormat": "TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "title": "Container Block I/O",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(docker_container_block_rx_bytes{name=\"school-admin-backend\"}[5m])",
          "legendFormat": "Block Read"
        },
        {
          "expr": "rate(docker_container_block_wx_bytes{name=\"school-admin-backend\"}[5m])",
          "legendFormat": "Block Write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "title": "All Container Resource Usage",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "docker_container_cpu_percent{job=\"cadvisor\"}",
          "legendFormat": "CPU {{ name }}"
        },
        {
          "expr": "docker_container_mem_percent{job=\"cadvisor\"}",
          "legendFormat": "Mem% {{ name }}"
        },
        {
          "expr": "docker_container_mem_usage_bytes{job=\"cadvisor\"}",
          "legendFormat": "Mem {{ name }}"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "name": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": []
              }
            }
          }
        }
      ]
    }
  ],
  "folderUid": "ops-monitoring"
}